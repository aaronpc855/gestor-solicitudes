# Copia este archivo como ".env" solo si necesitas cambiar la URL de la API.
# Si VITE_API_URL no se define, la SPA usa "/api" y el proxy de Vite
# la reenvía a http://localhost:3000 (backend de la PA2).
# El modo local (datos simulados) no necesita este archivo.
#
# VITE_API_URL=http://localhost:3000/api
